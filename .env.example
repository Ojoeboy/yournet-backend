# --- Core ---
PORT=4000
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Database (Postgres) ---
DATABASE_URL=postgres://yournet:yournet@localhost:5432/yournet

# --- Paystack (Ghana-friendly: cards + Mobile Money) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Flutterwave & Hubtel: PLATFORM-level, for the /license checkout only ---
# Paystack above already covers card + Mobile Money for license purchases.
# Add these too if you also want Flutterwave and/or Hubtel as checkout
# options on /license - the provider dropdown there only shows whichever
# of the three are actually configured, so leaving these blank just means
# Paystack is the only option shown. (Not to be confused with the
# per-TENANT Hubtel/Flutterwave credentials each WiFi business links from
# their own /admin - those are separate and stored in the database, see
# routes/paymentGateways.js.)
FLUTTERWAVE_SECRET_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# --- App URLs ---
APP_BASE_URL=https://yourdomain.com
PORTAL_BASE_URL=https://yourdomain.com/portal

# --- Licensing (one-time purchase to unlock a tenant account) ---
LICENSE_PRICE_GHS=500

# --- Owner login (this is YOU, not a tenant) ---
# Username is plain text (like any login form). Password is NEVER stored
# plaintext - only its hash. To change the password, generate a new hash
# with: node -e "console.log(require('./src/utils/passwordHash').hashPassword('yourNewPassword'))"
OWNER_USERNAME=change-me
OWNER_PASSWORD_HASH=generate-your-own-see-README-Owner-Login-section
OWNER_JWT_SECRET=change-this-to-a-different-long-random-string-than-JWT_SECRET

# --- Encryption for stored router/API credentials ---
# 32-byte key, base64-encoded. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=REPLACE-WITH-YOUR-OWN-GENERATED-KEY

# --- Email (Gmail SMTP - free, no domain required) ---
# Used for account verification and password reset emails.
# 1. Use a Gmail account (a dedicated one like yournet.control@gmail.com
#    is cleaner than your personal one, but either works).
# 2. Turn on 2-Step Verification on that Google account.
# 3. Generate an App Password at https://myaccount.google.com/apppasswords
#    (NOT your normal Gmail password - a 16-character app-specific one).
# 4. Paste that below as GMAIL_APP_PASSWORD.
# Free tier caps out around 500 emails/day - fine for testing and early
# real usage. Swap to Resend + a verified domain later once there's
# revenue, for branded "no-reply@yourdomain.com" sending.
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM=YourNet Control <your.address@gmail.com>

# --- Brevo (license key delivery from /license-admin) ---
# Separate from the Gmail settings above - used specifically for emailing
# a license key to a buyer (auto-sent when you issue one manually, or via
# the "Resend by email" tool on /license-admin). Get a free API key at
# https://app.brevo.com/settings/keys/api (free tier: 300 emails/day).
# Sender must be an address you've verified in Brevo (Settings > Senders
# & IP). Set it as BREVO_SENDER_EMAIL, or EMAIL_FROM_ADDRESS if that's
# already defined elsewhere in your setup - either name is read. Leave
# BREVO_API_KEY unset to skip real sending - the key is still
# shown/copyable on-screen either way.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=YourNet Control

# --- SMS (Arkesel - Ghana) ---
ARKESEL_API_KEY=your_arkesel_api_key_here
SMS_SENDER_ID=YourNet

# --- Rotating backgrounds (Pexels - free, no attribution required) ---
# Get a free key at https://www.pexels.com/api/ (instant approval, no cost).
# If left unset, the rotating-background feature just stays off everywhere
# (portal falls back to its plain background, admin pages keep the mesh) -
# nothing breaks, it just won't rotate photos until this is set.
PEXELS_API_KEY=your_pexels_api_key_here

# --- NOTE on the Hubtel/Flutterwave keys above ---
# Those are the PLATFORM's own credentials, used only for /license
# checkout. Separately, each individual WiFi business (tenant) can link
# their OWN Hubtel/Flutterwave/Paystack account through /admin so their
# customers' voucher payments go straight to them - that's a fully
# separate, per-tenant credential set stored in the database, not this
# file. See routes/paymentGateways.js.
