# --- Core ---
PORT=3000
DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
OWNER_JWT_SECRET=change-me-too
APP_BASE_URL=https://your-actual-app.onrender.com
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-key

# --- Owner/admin login ---
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=
OWNER_ALERT_EMAIL=
OWNER_ALERT_PHONE=
OWNER_MOMO_NUMBER=
OWNER_MOMO_NAME=

# --- Cloudflare R2 (object storage for tenant/portal logos) ---
# If any of these are unset, uploads fall back to base64 data: URLs stored
# directly in Postgres (old behavior) - fine for local dev, not recommended
# once you have real tenants (see storage.js).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yournet-logos
# Public base URL for the bucket - either the r2.dev dev subdomain, or a
# custom domain mapped to the bucket. No trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# --- Email (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_FROM_ADDRESS=

# --- SMS ---
ARKESEL_API_KEY=
SMS_SENDER_ID=

# --- Payment gateways ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# --- License / billing ---
LICENSE_GRACE_DAYS=7
LICENSE_SIGNUP_PRICE_GHS=
LICENSE_REACTIVATION_PRICE_GHS=
PPPOE_GRACE_DAYS=3

# --- Stock photos (background rotation feature) ---
PEXELS_API_KEY=
